{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentp.dev/schemas/2026-09/dict.schema.json",
  "title": "OpenTrackPlan Dictionary",
  "description": "Schema for OpenTrackPlan dictionary files (.yaml/.yml)",
  "type": "object",
  "required": ["opentp", "dict"],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "opentp": {
      "$ref": "version.schema.json"
    },
    "dict": {
      "type": "object",
      "description": "Dictionary definition",
      "required": ["type", "values"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "string" },
            "values": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "number" },
            "values": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "integer" },
            "values": {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "boolean" },
            "values": {
              "type": "array",
              "items": { "type": "boolean" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "x-opentp": {
      "not": {},
      "description": "Removed in 2026-09; see CHANGELOG.md"
    }
  }
}
