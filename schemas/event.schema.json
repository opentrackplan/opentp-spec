{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentp.dev/schemas/2026-09/event.schema.json",
  "title": "OpenTrackPlan Event",
  "description": "Schema for OpenTrackPlan event files (.yaml/.yml). Taxonomy values and payload fields are also checked by validators against opentp.yaml (docs/semantics.md).",
  "type": "object",
  "required": ["opentp", "event"],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "opentp": {
      "$ref": "version.schema.json"
    },
    "event": {
      "type": "object",
      "description": "Event definition",
      "required": ["key", "taxonomy", "payload"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/definitions/eventKey"
        },
        "lifecycle": {
          "type": "object",
          "description": "Event lifecycle information",
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "description": "Current event status",
              "enum": ["active", "deprecated", "draft"]
            },
            "deprecatedAt": {
              "type": "string",
              "description": "Date when the event was deprecated (RFC 3339 full-date, e.g. \"2025-01-01\")",
              "format": "date"
            },
            "deprecatedReason": {
              "type": "string",
              "description": "Reason for deprecation"
            },
            "replacedBy": {
              "$ref": "#/definitions/eventKey"
            },
            "x-opentp": {
              "not": {},
              "description": "Removed in 2026-09; see CHANGELOG.md"
            }
          }
        },
        "taxonomy": {
          "type": "object",
          "description": "Event metadata for organization. Fields defined in opentp.yaml"
        },
        "aliases": {
          "type": "array",
          "description": "Previous event keys (for migration)",
          "items": {
            "type": "object",
            "required": ["key"],
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/definitions/eventKey"
              },
              "deprecated": {
                "type": "object",
                "patternProperties": {
                  "^x-": {}
                },
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "x-opentp": {
                    "not": {},
                    "description": "Removed in 2026-09; see CHANGELOG.md"
                  }
                }
              },
              "x-opentp": {
                "not": {},
                "description": "Removed in 2026-09; see CHANGELOG.md"
              }
            }
          }
        },
        "ignore": {
          "type": "array",
          "description": "Checks to skip for this event (path grammar: docs/semantics.md, \"Ignore\")",
          "items": {
            "type": "object",
            "required": ["path"],
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "What to skip, e.g. 'key', 'taxonomy.<field>', 'payload.<field>' or 'payload::<field>'"
              },
              "reason": {
                "type": "string",
                "description": "Why the check is skipped (optional, recommended)"
              },
              "x-opentp": {
                "not": {},
                "description": "Removed in 2026-09; see CHANGELOG.md"
              }
            }
          }
        },
        "payload": {
          "type": "object",
          "description": "Data sent to analytics targets: one payload definition for every target (implicit form) or a map of selectors and target ids",
          "oneOf": [
            {
              "$ref": "#/definitions/target"
            },
            {
              "$ref": "#/definitions/payloadTargets"
            }
          ]
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "x-opentp": {
      "not": {},
      "description": "Removed in 2026-09; see CHANGELOG.md"
    }
  },
  "definitions": {
    "eventKey": {
      "type": "string",
      "description": "Event key / identifier. Opaque string that must be unique within a tracking plan.",
      "minLength": 1
    },
    "payloadTargets": {
      "type": "object",
      "description": "Map form: payload.<selectorOrTargetId>, each covering a set of targets (a target at most once)",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/target"
      }
    },
    "target": {
      "description": "Payload definition for a target. Can be unversioned (schema/meta) or versioned (current + versions map).",
      "oneOf": [
        {
          "$ref": "#/definitions/payloadVersion"
        },
        {
          "$ref": "#/definitions/versionedTarget"
        }
      ]
    },
    "versionedTarget": {
      "type": "object",
      "description": "Versioned payload for a target. Keys with object values are versions; keys with string values are aliases (tags).",
      "required": ["current"],
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/payloadVersion"
          },
          {
            "type": "string",
            "description": "Alias/tag pointing to an existing version key"
          }
        ]
      },
      "properties": {
        "current": {
          "type": "string",
          "description": "Current payload version or alias: what new code sends"
        }
      },
      "allOf": [
        {
          "description": "a versioned payload has no schema of its own",
          "not": {
            "required": ["schema"]
          }
        }
      ]
    },
    "payloadVersion": {
      "type": "object",
      "description": "A payload schema snapshot (optionally derived from another version via $ref)",
      "required": ["schema"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string",
          "description": "Version to derive from: '<versionKey>' or '<payloadKey>::<versionKey>' (map form)"
        },
        "meta": {
          "$ref": "#/definitions/payloadMeta"
        },
        "schema": {
          "type": "object",
          "description": "Fields of this event: catalog fields it uses and common fields it narrows (write {} to list a field unchanged)",
          "additionalProperties": {
            "$ref": "field.schema.json#/definitions/eventField"
          }
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "payloadMeta": {
      "type": "object",
      "description": "Metadata about this payload version",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "changes": {
          "description": "Human-readable changes in this version",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "deprecated": {
          "type": "object",
          "description": "Deprecation info for this payload version (deprecated versions are exempt from policy)",
          "required": ["reason"],
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "x-opentp": {
              "not": {},
              "description": "Removed in 2026-09; see CHANGELOG.md"
            }
          }
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    }
  }
}
