{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentp.dev/schemas/2026-09/field.schema.json",
  "title": "OpenTrackPlan Field",
  "description": "Payload field definition. This schema is used for common fields (spec.targets.<id>.schema); catalog fields use #/definitions/catalogField and event fields #/definitions/eventField. Use 'value' for a fixed value and 'enum' or 'dict' to restrict allowed values. 'type' may be omitted where it is inherited from the catalog or spec.targets.",
  "type": "object",
  "allOf": [
    {
      "description": "enum and dict are mutually exclusive",
      "not": { "required": ["enum", "dict"] }
    },
    {
      "description": "enum and value are mutually exclusive",
      "not": { "required": ["enum", "value"] }
    },
    {
      "description": "dict and value are mutually exclusive",
      "not": { "required": ["dict", "value"] }
    },
    {
      "description": "required: false contradicts value (a field with a value is always present)",
      "not": {
        "required": ["value", "required"],
        "properties": { "required": { "const": false } }
      }
    },
    {
      "description": "required: false contradicts policy restricted or fixed (such a field is always present)",
      "not": {
        "required": ["policy", "required"],
        "properties": {
          "policy": { "enum": ["restricted", "fixed"] },
          "required": { "const": false }
        }
      }
    }
  ],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Code-facing field name (for example a generated parameter name). The YAML key remains the canonical payload field key."
    },
    "title": {
      "type": "string",
      "description": "Human-readable field name"
    },
    "description": {
      "type": "string",
      "description": "Field description"
    },
    "type": {
      "type": "string",
      "description": "Data type. Required in the catalog; elsewhere it may be inherited.",
      "enum": ["string", "number", "integer", "boolean", "array"]
    },
    "enum": {
      "type": "array",
      "description": "Allowed values (at least one; scalars of the field's type)",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scalar" }
    },
    "dict": {
      "type": "string",
      "description": "Reference to a dictionary (e.g., 'data/application_id')"
    },
    "value": {
      "description": "Fixed value: the field is always present and equals this value",
      "anyOf": [
        { "$ref": "#/definitions/scalar" },
        { "type": "array", "items": { "$ref": "#/definitions/scalar" } }
      ]
    },
    "example": {
      "description": "Example value for documentation, mock data and generators. It must satisfy the field.",
      "anyOf": [
        { "$ref": "#/definitions/scalar" },
        { "type": "array", "items": { "$ref": "#/definitions/scalar" } }
      ]
    },
    "required": {
      "type": "boolean",
      "description": "Whether the field is present in every hit. On a catalog or common field, true is a minimum that events cannot weaken."
    },
    "policy": {
      "type": "string",
      "description": "What every event must do with this field (catalog and common fields only): specified = list it, restricted = restrict it with value, enum or dict, fixed = set its value",
      "enum": ["specified", "restricted", "fixed"]
    },
    "minLength": {
      "type": "integer",
      "minimum": 0,
      "description": "Minimum string length in Unicode code points (type: string)"
    },
    "maxLength": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum string length in Unicode code points (type: string)"
    },
    "pattern": {
      "type": "string",
      "description": "Regular expression (ECMA-262 with Unicode, not anchored) the string must match (type: string)"
    },
    "format": {
      "$ref": "#/definitions/format"
    },
    "minimum": {
      "type": "number",
      "description": "Minimum numeric value (type: number | integer)"
    },
    "maximum": {
      "type": "number",
      "description": "Maximum numeric value (type: number | integer)"
    },
    "exclusiveMinimum": {
      "type": "number",
      "description": "Exclusive minimum numeric value (type: number | integer)"
    },
    "exclusiveMaximum": {
      "type": "number",
      "description": "Exclusive maximum numeric value (type: number | integer)"
    },
    "multipleOf": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Numeric multiple constraint (type: number | integer)"
    },
    "items": {
      "$ref": "#/definitions/arrayItems"
    },
    "minItems": {
      "type": "integer",
      "minimum": 0,
      "description": "Minimum array length (type: array)"
    },
    "maxItems": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum array length (type: array)"
    },
    "uniqueItems": {
      "type": "boolean",
      "description": "Whether array items must be unique (type: array)"
    },
    "pii": {
      "type": "object",
      "description": "PII metadata: the reserved keys kind and masker, plus the metadata keys defined in spec.events.pii.schema",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "description": "PII kind identifier (reserved; configured in opentp.yaml)"
        },
        "masker": {
          "type": "string",
          "description": "Masker implementation id (reserved; configured in opentp.yaml)"
        }
      }
    },
    "checks": {
      "$ref": "#/definitions/checks"
    },
    "x-opentp": {
      "not": {},
      "description": "Removed in 2026-09; see CHANGELOG.md"
    }
  },
  "oneOf": [
    {
      "description": "Untyped field: the type is inherited from the catalog or spec.targets, and validators check enum, value, example and constraints against it",
      "not": { "required": ["type"] }
    },
    {
      "description": "String field",
      "required": ["type"],
      "properties": {
        "type": { "const": "string" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "value": { "type": "string" },
        "example": { "type": "string" }
      },
      "not": {
        "anyOf": [
          { "required": ["minimum"] },
          { "required": ["maximum"] },
          { "required": ["exclusiveMinimum"] },
          { "required": ["exclusiveMaximum"] },
          { "required": ["multipleOf"] },
          { "required": ["items"] },
          { "required": ["minItems"] },
          { "required": ["maxItems"] },
          { "required": ["uniqueItems"] }
        ]
      }
    },
    {
      "description": "Number field",
      "required": ["type"],
      "properties": {
        "type": { "const": "number" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "value": { "type": "number" },
        "example": { "type": "number" }
      },
      "not": {
        "anyOf": [
          { "required": ["minLength"] },
          { "required": ["maxLength"] },
          { "required": ["pattern"] },
          { "required": ["format"] },
          { "required": ["items"] },
          { "required": ["minItems"] },
          { "required": ["maxItems"] },
          { "required": ["uniqueItems"] }
        ]
      }
    },
    {
      "description": "Integer field",
      "required": ["type"],
      "properties": {
        "type": { "const": "integer" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "value": { "type": "integer" },
        "example": { "type": "integer" }
      },
      "not": {
        "anyOf": [
          { "required": ["minLength"] },
          { "required": ["maxLength"] },
          { "required": ["pattern"] },
          { "required": ["format"] },
          { "required": ["items"] },
          { "required": ["minItems"] },
          { "required": ["maxItems"] },
          { "required": ["uniqueItems"] }
        ]
      }
    },
    {
      "description": "Boolean field",
      "required": ["type"],
      "properties": {
        "type": { "const": "boolean" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "boolean" } },
        "value": { "type": "boolean" },
        "example": { "type": "boolean" }
      },
      "not": {
        "anyOf": [
          { "required": ["minLength"] },
          { "required": ["maxLength"] },
          { "required": ["pattern"] },
          { "required": ["format"] },
          { "required": ["minimum"] },
          { "required": ["maximum"] },
          { "required": ["exclusiveMinimum"] },
          { "required": ["exclusiveMaximum"] },
          { "required": ["multipleOf"] },
          { "required": ["items"] },
          { "required": ["minItems"] },
          { "required": ["maxItems"] },
          { "required": ["uniqueItems"] }
        ]
      }
    },
    {
      "description": "Array field (arrays of scalar items only; restrict the elements with items.enum or items.dict)",
      "required": ["type"],
      "properties": {
        "type": { "const": "array" },
        "value": { "type": "array", "items": { "$ref": "#/definitions/scalar" } },
        "example": { "type": "array", "items": { "$ref": "#/definitions/scalar" } }
      },
      "not": {
        "anyOf": [
          { "required": ["enum"] },
          { "required": ["dict"] },
          { "required": ["minLength"] },
          { "required": ["maxLength"] },
          { "required": ["pattern"] },
          { "required": ["format"] },
          { "required": ["minimum"] },
          { "required": ["maximum"] },
          { "required": ["exclusiveMinimum"] },
          { "required": ["exclusiveMaximum"] },
          { "required": ["multipleOf"] }
        ]
      }
    }
  ],
  "definitions": {
    "catalogField": {
      "description": "Catalog field (spec.events.payload.schema.<field>): a Field with a type; an array field also needs items",
      "allOf": [
        { "$ref": "#" },
        { "required": ["type"] },
        {
          "description": "an array field in the catalog needs items",
          "anyOf": [
            {
              "not": {
                "required": ["type"],
                "properties": { "type": { "const": "array" } }
              }
            },
            { "required": ["items"] }
          ]
        }
      ]
    },
    "eventField": {
      "description": "Event field (schema.<field> of a payload version): a Field without policy; the type may be inherited",
      "allOf": [
        { "$ref": "#" },
        {
          "properties": {
            "policy": {
              "not": {},
              "description": "policy is set on catalog and common fields in opentp.yaml, not in events"
            }
          }
        }
      ]
    },
    "scalar": {
      "description": "A scalar value: string, number (integers included) or boolean",
      "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
    },
    "format": {
      "type": "string",
      "description": "String format (defined in docs/semantics.md): date and date-time per RFC 3339, email, uuid, absolute uri, ipv4, ipv6",
      "enum": ["date", "date-time", "email", "uuid", "uri", "ipv4", "ipv6"]
    },
    "checks": {
      "type": "object",
      "description": "Checks by id: { <checkId>: <params> }. An id defined in spec.checks takes true (enable) or false (disable); any other id is tool-defined. false disables a check that an earlier layer set.",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_.-]*$": {}
      },
      "additionalProperties": false
    },
    "arrayItems": {
      "type": "object",
      "description": "Array item schema. Only scalar item types are allowed; the type may be inherited.",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Item type (required on the effective field)",
          "enum": ["string", "number", "integer", "boolean"]
        },
        "enum": {
          "type": "array",
          "description": "Allowed values for each array item (at least one)",
          "minItems": 1,
          "items": { "$ref": "#/definitions/scalar" }
        },
        "dict": {
          "type": "string",
          "description": "Reference to a dictionary (e.g., 'data/tags')"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "format": {
          "$ref": "#/definitions/format"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checks": {
          "$ref": "#/definitions/checks"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      },
      "allOf": [
        {
          "description": "enum and dict are mutually exclusive",
          "not": { "required": ["enum", "dict"] }
        }
      ],
      "oneOf": [
        {
          "description": "Untyped items: the item type is inherited",
          "not": { "required": ["type"] }
        },
        {
          "required": ["type"],
          "properties": {
            "type": { "const": "string" },
            "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "not": {
            "anyOf": [
              { "required": ["minimum"] },
              { "required": ["maximum"] },
              { "required": ["exclusiveMinimum"] },
              { "required": ["exclusiveMaximum"] },
              { "required": ["multipleOf"] }
            ]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": { "const": "number" },
            "enum": { "type": "array", "minItems": 1, "items": { "type": "number" } }
          },
          "not": {
            "anyOf": [
              { "required": ["minLength"] },
              { "required": ["maxLength"] },
              { "required": ["pattern"] },
              { "required": ["format"] }
            ]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": { "const": "integer" },
            "enum": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
          },
          "not": {
            "anyOf": [
              { "required": ["minLength"] },
              { "required": ["maxLength"] },
              { "required": ["pattern"] },
              { "required": ["format"] }
            ]
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": { "const": "boolean" },
            "enum": { "type": "array", "minItems": 1, "items": { "type": "boolean" } }
          },
          "not": {
            "anyOf": [
              { "required": ["minLength"] },
              { "required": ["maxLength"] },
              { "required": ["pattern"] },
              { "required": ["format"] },
              { "required": ["minimum"] },
              { "required": ["maximum"] },
              { "required": ["exclusiveMinimum"] },
              { "required": ["exclusiveMaximum"] },
              { "required": ["multipleOf"] }
            ]
          }
        }
      ]
    }
  }
}
