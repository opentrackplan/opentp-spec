{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentp.dev/schemas/2026-09/opentp.schema.json",
  "title": "OpenTrackPlan Configuration",
  "description": "Schema for opentp.yaml - the main configuration file of a tracking plan",
  "type": "object",
  "required": ["opentp", "info", "spec"],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "properties": {
    "opentp": {
      "$ref": "version.schema.json"
    },
    "info": {
      "type": "object",
      "description": "Project metadata",
      "required": ["title", "version"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "description": {
          "type": "string",
          "description": "Project description"
        },
        "version": {
          "type": "string",
          "description": "Project version (quote numbers such as \"1.0\")"
        },
        "contact": {
          "type": "array",
          "description": "Contact information",
          "items": {
            "type": "string"
          }
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "spec": {
      "type": "object",
      "description": "Specification",
      "required": ["paths", "events"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "object",
          "description": "File paths configuration",
          "required": ["events"],
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "properties": {
            "events": {
              "$ref": "#/definitions/eventsPathConfig"
            },
            "dictionaries": {
              "$ref": "#/definitions/dictionariesPathConfig"
            },
            "x-opentp": {
              "not": {},
              "description": "Removed in 2026-09; see CHANGELOG.md"
            }
          }
        },
        "targets": {
          "type": "object",
          "description": "Common fields per target. Keys are 'all' (fields common to every target) or target ids from spec.events.payload.targets.all (checked by validators).",
          "additionalProperties": {
            "$ref": "#/definitions/targetConfig"
          }
        },
        "checks": {
          "type": "object",
          "description": "Portable named checks: { <checkId>: PortableCheck }. In the plan, checks: { <checkId>: true } applies one.",
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]*$": {
              "$ref": "#/definitions/portableCheck"
            }
          },
          "additionalProperties": false
        },
        "events": {
          "type": "object",
          "description": "Events configuration",
          "required": ["taxonomy", "payload"],
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/definitions/eventKeyConstraints"
            },
            "taxonomy": {
              "type": "object",
              "description": "Taxonomy fields definition",
              "additionalProperties": {
                "$ref": "#/definitions/taxonomyField"
              }
            },
            "payload": {
              "type": "object",
              "description": "Payload configuration: targets and the field catalog",
              "required": ["targets"],
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "properties": {
                "targets": {
                  "type": "object",
                  "description": "Target ids and selector groups. 'all' is required and reserved: the canonical list of target ids. Other keys are selector groups of ids from 'all'.",
                  "required": ["all"],
                  "properties": {
                    "all": {
                      "type": "array",
                      "description": "Every target id of the plan",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "description": "Field catalog: every field that events may use (being in the catalog does not put a field into an event). Optional; defaults to {}.",
                  "additionalProperties": {
                    "$ref": "field.schema.json#/definitions/catalogField"
                  }
                },
                "x-opentp": {
                  "not": {},
                  "description": "Removed in 2026-09; see CHANGELOG.md"
                }
              }
            },
            "pii": {
              "$ref": "#/definitions/piiConfig"
            },
            "x-opentp": {
              "not": {},
              "description": "Removed in 2026-09 (key generation is tool configuration, e.g. opentp.cli.yaml in the reference CLI); see CHANGELOG.md"
            }
          }
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "x-opentp": {
      "not": {},
      "description": "Removed in 2026-09; see CHANGELOG.md"
    }
  },
  "definitions": {
    "eventsPathConfig": {
      "type": "object",
      "description": "Path configuration for event files",
      "required": ["root", "template"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "description": "Root directory, relative to the directory of opentp.yaml (a leading '/' means that directory)"
        },
        "template": {
          "type": "string",
          "description": "Path template using taxonomy fields (e.g. '{area}/{event}.yaml')"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "dictionariesPathConfig": {
      "type": "object",
      "description": "Path configuration for dictionary files",
      "required": ["root"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "description": "Root directory, relative to the directory of opentp.yaml (a leading '/' means that directory)"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "eventKeyConstraints": {
      "type": "object",
      "description": "Constraints for event.key values (opaque string identifier). Key generation is not part of the specification.",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum key length in Unicode code points"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum key length in Unicode code points"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression for event keys (ECMA-262 with Unicode, not anchored)"
        },
        "format": {
          "$ref": "field.schema.json#/definitions/format"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "targetConfig": {
      "type": "object",
      "description": "Target configuration: 'all' or a target id",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Human-readable name"
        },
        "description": {
          "type": "string",
          "description": "Target description"
        },
        "schema": {
          "type": "object",
          "description": "Common fields: part of every event on this target (or on every target, for 'all'). Merged catalog -> all -> <targetId> -> event.",
          "additionalProperties": {
            "$ref": "field.schema.json"
          }
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "portableCheck": {
      "type": "object",
      "description": "A portable named check: built only from portable keywords (at least one). A value passes when it satisfies every keyword that applies to its type.",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Human-readable check name"
        },
        "description": {
          "type": "string",
          "description": "Check description"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum string length in Unicode code points (applies to strings)"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum string length in Unicode code points (applies to strings)"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression (applies to strings)"
        },
        "format": {
          "$ref": "field.schema.json#/definitions/format"
        },
        "minimum": {
          "type": "number",
          "description": "Minimum value (applies to numbers)"
        },
        "maximum": {
          "type": "number",
          "description": "Maximum value (applies to numbers)"
        },
        "exclusiveMinimum": {
          "type": "number",
          "description": "Exclusive minimum (applies to numbers)"
        },
        "exclusiveMaximum": {
          "type": "number",
          "description": "Exclusive maximum (applies to numbers)"
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Numeric multiple (applies to numbers)"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      },
      "anyOf": [
        { "required": ["minLength"] },
        { "required": ["maxLength"] },
        { "required": ["pattern"] },
        { "required": ["format"] },
        { "required": ["minimum"] },
        { "required": ["maximum"] },
        { "required": ["exclusiveMinimum"] },
        { "required": ["exclusiveMaximum"] },
        { "required": ["multipleOf"] }
      ]
    },
    "taxonomyField": {
      "type": "object",
      "description": "Taxonomy field definition",
      "required": ["title", "type"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Human-readable field name"
        },
        "description": {
          "type": "string",
          "description": "Field description"
        },
        "type": {
          "type": "string",
          "description": "Data type",
          "enum": ["string", "number", "integer", "boolean"]
        },
        "required": {
          "type": "boolean",
          "description": "Whether this field is required"
        },
        "template": {
          "type": "string",
          "description": "Template for composite fields using fragments (e.g. '{verb} - {object}')"
        },
        "enum": {
          "type": "array",
          "description": "Inline list of allowed values (at least one)",
          "minItems": 1,
          "items": {
            "$ref": "field.schema.json#/definitions/scalar"
          }
        },
        "dict": {
          "type": "string",
          "description": "Reference to dictionary (e.g., 'taxonomy/areas')"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum string length in Unicode code points (type: string)"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum string length in Unicode code points (type: string)"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression (type: string)"
        },
        "format": {
          "$ref": "field.schema.json#/definitions/format"
        },
        "minimum": {
          "type": "number",
          "description": "Minimum numeric value (type: number | integer)"
        },
        "maximum": {
          "type": "number",
          "description": "Maximum numeric value (type: number | integer)"
        },
        "exclusiveMinimum": {
          "type": "number",
          "description": "Exclusive minimum numeric value (type: number | integer)"
        },
        "exclusiveMaximum": {
          "type": "number",
          "description": "Exclusive maximum numeric value (type: number | integer)"
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Numeric multiple constraint (type: number | integer)"
        },
        "fragments": {
          "type": "object",
          "description": "Sub-fields for composite fields",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/taxonomyField"
          }
        },
        "checks": {
          "$ref": "field.schema.json#/definitions/checks"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      },
      "allOf": [
        {
          "description": "enum and dict are mutually exclusive",
          "not": { "required": ["enum", "dict"] }
        },
        {
          "description": "template and fragments are used together",
          "oneOf": [
            {
              "not": {
                "anyOf": [{ "required": ["template"] }, { "required": ["fragments"] }]
              }
            },
            {
              "required": ["template", "fragments"]
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": { "const": "string" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["minimum"] },
                  { "required": ["maximum"] },
                  { "required": ["exclusiveMinimum"] },
                  { "required": ["exclusiveMaximum"] },
                  { "required": ["multipleOf"] }
                ]
              }
            },
            {
              "properties": {
                "type": { "const": "number" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "number" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["template"] },
                  { "required": ["fragments"] },
                  { "required": ["minLength"] },
                  { "required": ["maxLength"] },
                  { "required": ["pattern"] },
                  { "required": ["format"] }
                ]
              }
            },
            {
              "properties": {
                "type": { "const": "integer" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["template"] },
                  { "required": ["fragments"] },
                  { "required": ["minLength"] },
                  { "required": ["maxLength"] },
                  { "required": ["pattern"] },
                  { "required": ["format"] }
                ]
              }
            },
            {
              "properties": {
                "type": { "const": "boolean" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "boolean" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["template"] },
                  { "required": ["fragments"] },
                  { "required": ["minLength"] },
                  { "required": ["maxLength"] },
                  { "required": ["pattern"] },
                  { "required": ["format"] },
                  { "required": ["minimum"] },
                  { "required": ["maximum"] },
                  { "required": ["exclusiveMinimum"] },
                  { "required": ["exclusiveMaximum"] },
                  { "required": ["multipleOf"] }
                ]
              }
            }
          ]
        }
      ]
    },
    "piiConfig": {
      "type": "object",
      "description": "PII metadata configuration for payload fields",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/piiReservedFieldConfig"
        },
        "masker": {
          "$ref": "#/definitions/piiReservedFieldConfig"
        },
        "schema": {
          "type": "object",
          "description": "Additional PII metadata fields (validated by tooling)",
          "additionalProperties": {
            "$ref": "#/definitions/piiMetaField"
          }
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      }
    },
    "piiReservedFieldConfig": {
      "type": "object",
      "description": "Configuration for reserved PII fields (pii.kind, pii.masker)",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Human-readable field name"
        },
        "description": {
          "type": "string",
          "description": "Field description"
        },
        "required": {
          "type": "boolean",
          "description": "Whether this PII field is required when pii is present"
        },
        "enum": {
          "type": "array",
          "description": "Inline list of allowed values (at least one)",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dict": {
          "type": "string",
          "description": "Reference to dictionary (e.g., 'governance/pii-kinds')"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum string length in Unicode code points"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum string length in Unicode code points"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression"
        },
        "format": {
          "$ref": "field.schema.json#/definitions/format"
        },
        "checks": {
          "$ref": "field.schema.json#/definitions/checks"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      },
      "allOf": [
        {
          "description": "enum and dict are mutually exclusive",
          "not": { "required": ["enum", "dict"] }
        }
      ]
    },
    "piiMetaField": {
      "type": "object",
      "description": "Additional PII metadata field definition",
      "required": ["type"],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Human-readable field name"
        },
        "description": {
          "type": "string",
          "description": "Field description"
        },
        "type": {
          "type": "string",
          "description": "Data type",
          "enum": ["string", "number", "integer", "boolean"]
        },
        "required": {
          "type": "boolean",
          "description": "Whether this field is required when pii is present"
        },
        "enum": {
          "type": "array",
          "description": "Inline list of allowed values (at least one)",
          "minItems": 1,
          "items": {
            "$ref": "field.schema.json#/definitions/scalar"
          }
        },
        "dict": {
          "type": "string",
          "description": "Reference to dictionary (e.g., 'governance/pii-owners')"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum string length in Unicode code points (type: string)"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum string length in Unicode code points (type: string)"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression (type: string)"
        },
        "format": {
          "$ref": "field.schema.json#/definitions/format"
        },
        "minimum": {
          "type": "number",
          "description": "Minimum numeric value (type: number | integer)"
        },
        "maximum": {
          "type": "number",
          "description": "Maximum numeric value (type: number | integer)"
        },
        "exclusiveMinimum": {
          "type": "number",
          "description": "Exclusive minimum numeric value (type: number | integer)"
        },
        "exclusiveMaximum": {
          "type": "number",
          "description": "Exclusive maximum numeric value (type: number | integer)"
        },
        "multipleOf": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Numeric multiple constraint (type: number | integer)"
        },
        "checks": {
          "$ref": "field.schema.json#/definitions/checks"
        },
        "x-opentp": {
          "not": {},
          "description": "Removed in 2026-09; see CHANGELOG.md"
        }
      },
      "allOf": [
        {
          "description": "enum and dict are mutually exclusive",
          "not": { "required": ["enum", "dict"] }
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": { "const": "string" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["minimum"] },
                  { "required": ["maximum"] },
                  { "required": ["exclusiveMinimum"] },
                  { "required": ["exclusiveMaximum"] },
                  { "required": ["multipleOf"] }
                ]
              }
            },
            {
              "properties": {
                "type": { "const": "number" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "number" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["minLength"] },
                  { "required": ["maxLength"] },
                  { "required": ["pattern"] },
                  { "required": ["format"] }
                ]
              }
            },
            {
              "properties": {
                "type": { "const": "integer" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["minLength"] },
                  { "required": ["maxLength"] },
                  { "required": ["pattern"] },
                  { "required": ["format"] }
                ]
              }
            },
            {
              "properties": {
                "type": { "const": "boolean" },
                "enum": { "type": "array", "minItems": 1, "items": { "type": "boolean" } }
              },
              "not": {
                "anyOf": [
                  { "required": ["minLength"] },
                  { "required": ["maxLength"] },
                  { "required": ["pattern"] },
                  { "required": ["format"] },
                  { "required": ["minimum"] },
                  { "required": ["maximum"] },
                  { "required": ["exclusiveMinimum"] },
                  { "required": ["exclusiveMaximum"] },
                  { "required": ["multipleOf"] }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
